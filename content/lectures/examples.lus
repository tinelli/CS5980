(* Figure 2.1
   IntDelay: a one-step delay node with integer input and output.  
   The output is the previous input, with an initial value of 0.
   (The original version in the textbook uses Boolean values).
*)
node IntDelay(inp: int) returns (out: int) ;
  var x: int ;
let
  out = x ;
  x = 0 -> pre inp ;
tel

(* Delay: a generic (polymorphic) delay node for any type T.  
   The output is the previous input, with an arbitrary initial value 
   of type T.
*)
node Delay<T>(inp: T) returns (out: T) ;
  var x0, x: T ;
let
  x0 = any@<T>;
  out = x ;
  x = x0 -> pre inp ;
tel

node abs(x: int) returns (y: int) ;
let
  y = if x >= 0 then x else -x ;

  check y >= 0 ;
  check y >= x ;
  check y >= -x ;
  check y = x or y = -x ;
tel

node inc(x: int) returns (y: int) ;
  var fx: int ;
let
  fx = x -> pre fx ;

  y = x -> pre y + 2 ;
  check true -> y > pre y ;
  check true -> y - pre y = 2;
  check y >= x; -- invalid!
  check y >= fx; -- valid
tel 

node DiffSquare(in1, in2: int) returns (out: int) ;
let
  out = in1 * in1 - in2 * in2 ;
tel

node DiffSquare1(i1, i2: int) returns (o: int) ;
  var x, y: int ;
let
  x = i1 + i2 ;
  y = i1 - i2 ;
  o = x * y;

  -- nodeDiffSquare1 is equivalent to nodeDiffSquare 
  -- but it uses fewer multiplications.
  check o = DiffSquare(i1, i2) ;
tel

(*
        +----------------------+
        | bool x := 0 ; y := 0 |
        +----------------------+
        | bool in              |
        | if y then            |  
 bool i |   o := x             | bool o
  ----->| else                 |------>
        |   o := 0 ;           |
        | x := i ;             |
        | y := ¬y              |
        +----------------------+
*)

node Mistery(i: bool) returns (o: bool) ;
  var x, y: bool ;
let
  o = if (false -> pre y) then (false -> pre x) else false;
  x = false -> i ;
  y = false -> not pre y ;
tel

/*
  Alternative implementation of the Mistery node using 
  an if ... then ... else ... fi statement instead of 
  a conditional expression.
*/
node Mistery1(i: bool) returns (o: bool) ;
  var x, y: bool ;
let
  if false -> y then 
    o = false -> pre x ;
  else 
    o = false ;
  fi
  x = false -> i ;
  y = false -> not pre y ;
  -- the if statement above is equivalent to the conditional expression 
  -- in node Mistery
tel

(* Figure 2.2
  A simple switch that can be in one of two states: on or off.
  The switch changes state based on the press input and a counter x.
 
             *----*                                     *----*
   (~press)  |    |     (~press & x < 4) -> x := x + 1  |    |
             |    v                                     |    v
            +-------+            (press)               +------+
int x := 0  |       |--------------------------------->|      |
  --------> |  off  |    (press | x >= 4) -> x := 0    |  on  |
            |       |<---------------------------------|      |
            +-------+                                  +------+
*)

type status = enum {on, off};

(*
  Idiomatic definition of the switch component above in Lustre.
*)
node Switch(press: bool) returns (mode: status) ;
  var x: int ;
let
  mode = off -> if pre mode = off 
                then (if press then on else off)
                else (if press or pre x >= 4 then off else on) ;

  x = 0 -> if pre mode = off 
           then pre x
           else (if press or pre x >= 4 then 0 else pre x + 1) ;

  check "P1" 0 <= x ;
  check "P2" x <= 4 ;
  check "P3" x <> 0 => mode = on ;
  check "P4" true -> x <> 0 => x > pre x ;
tel

(*
  Alternative implementation of the switch component based
  on a more explicit state machine representation.
*)
node Switch1(press: bool) returns (mode: status);
  var x: int ;
let
  if true -> false then -- true only initially
    mode = off ;
    x = 0 ;
  elsif (false -> pre mode = off) then
    if press then
      mode = on ;
    else
      mode = off ;
    fi
    x = 0 -> pre x ;
  elsif press or (false -> pre x >= 4) then
    mode = off ;
    x = 0 ;
  else
    mode = on ;
    x = 0 -> pre x + 1 ;
  fi
tel

type event = enum {pres, abs};

(*
  A cyclic counter that counts the number of input events and
  outputs an event every 60 input events. 
*)
node sec2min(sec: event) returns (min: event) ;
  var x, px: int ;    
let
  px = 0 -> pre x ;

  x = 0 -> if sec = pres
           then if px = 59 then 0 else px + 1
           else px ;
  min = abs -> if px = 59 and sec = pres then pres else abs ;
tel

-- Parallel composition of nodes is achieved by applying nodes
-- as macros. 

(* Figure 2.15
     +------------------------------------+
     |   DoubleDelay                      |
     |                                    |
     |  +-----------+      +-----------+  |
 inp |  |           | temp |           |  | out
 ----+->|   Delay   |----->|   Delay   |--+---->
     |  |           |      |           |  |
     |  +-----------+      +-----------+  |
     |                                    |
     +------------------------------------+
*)
node DoubleDelay<T>(inp: T) returns (out: T) ;
  var temp: T ;
let
  out  = Delay@<T>(temp) ;
  temp = Delay@<T>(inp) ;
tel

(* Figure 2.25 
  A simple latch that can be set or reset. The latch is set when the 
  set_req input is true and reset when the reset input is true. 
  When both inputs are true, the latch is set or reset depending
  on the value of b, which is arbitrary.
  The latch retains its state when both inputs are false.
*)
node Latch(set_sig, reset_sig: bool) returns (out: bool) ;
  var x, b: bool ;
let
  b = any@<bool> ; -- value of b at each round is arbitrary

  out = b -> pre x ;
  
  -- the next output value of the latch is defined in terms 
  -- of the current input values
  -- When set and reset are both true the value of x is arbitrary (equal to b)
  x = (set_sig and (not reset_sig or b)) or 
      (not set_sig and not reset_sig and out) ;

  -- Initially, out is false (in every execution) [invalid]
  check "P1" (out = false) -> true ;
  check "P2" not out -> true ; -- more concise version of the previous property
  -- Initially, out is true [invalid]
  check "P3" out -> true ;
  -- Initially, out is equal to b (hence, arbitrary)
  check "P4" (out = b) -> true ;
  -- In all later rounds, x is true if there is a set [invalid]
  check "P5" true -> set_sig => x ;
  -- In all later rounds, x is true if there is a reset [invalid]
  check "P6" true -> reset_sig => not x ;
  -- In all later rounds, x is true if there is a set and no reset
  check "P7" true -> (set_sig and not reset_sig) => x ;
  -- In all later rounds, x is false if there is a reset and no set
  check "P8" true -> (not set_sig and reset_sig) => not x ;
  -- In all later rounds, x is equal to b if there is 
  -- a concurrent set and a reset
  check "P9" true -> (set_sig and reset_sig) => x = b ;
  -- In all later rounds, x is keeps its previous value if there is
  -- no set and no reset
  check "P10" true -> (not set_sig and not reset_sig) => x = pre x ;
tel

(* Figure 2.26

       +--------------------------------------------------------------+
       |                                                              |
       |   +--------------------------------------------------------+ |
       |   |                                              +-------+ | |
       | +-|-----------------------------------|``-.  set |       | | |
       | | |                          |`-._    |    :---->|       | | |
       | | +->|``-.                +--|   _]o--|..-`      | Latch | | |
       | |    |    :--+----\``-.   |  |.-`          reset |       |-+----> out
  inc ---+----|..-`   |     )   :--+--------------------->|       |   |
       |              | +--/..-`                          +-------+   |
       |              | |                                             |
start ------------------+                OneBitCounter                |
       |              |                                               |
       +--------------+-----------------------------------------------+
                      |     
                      v carry

-- 'OneBitCounter' is a stateful 1-bit counter implemented using 
-- the latch component modeled by 'Latch'.
-- The counter goes from 0 (actually, to 'false') to 1 (actually, 'true')
-- with a carry value of 0, or from 1 to 0 with a carry value of 1 when
-- the increment signal 'inc' is true.
-- It is reset to 0 (actually, to 'false') when the start signal is true.
-- The initial value of the counter is arbitrary (as provided by 'Latch')
*)
node OneBitCounter(inc, start: bool) returns (out, carry: bool) ;
  var set_sig, reset_sig: bool;
let
  out = Latch(set_sig, reset_sig) ;

  set_sig = inc and not reset_sig ; 

  reset_sig = carry or start ;

  carry = inc and out ;
tel
(* Note: 
   Kind 2 correctly determines that there are no definitional cycles
   in the definition of OneBitCounter, even if out is apparently defined 
   in terms of itself (out -> reset_sig -> carry --> out). 
   The reason is that the output of Latch is based on the *previous* value
   of its inputs.
*)

(* Figure 2.27
  This is a 3-bit counter implemented composing three instances
  of the OneBitCounter component.
*)
node ThreeBitCounter(inc, start: bool) 
returns (out0, out1, out2: bool) ;
  var carry0, carry1, carry2: bool;
let
  (out0, carry0) = OneBitCounter(inc,    start) ;
  (out1, carry1) = OneBitCounter(carry0, start) ;
  (out2, carry2) = OneBitCounter(carry1, start) ;
tel

(*
  This is an integer counter implemented using a single state variable
  c of type subrange [0,7] of int. The counter goes from 0 to 7 and 
  then wraps around to 0. 
  It is incremented when the inc signal is true and retains its value
  when the inc signal is false.
  It is reset to 0 when the start signal is true.
  It is a delayed counter, meaning that the output value is actually
  the previous value of the counter.
*)
node DelayedCounter(inc, start: bool) returns (n: subrange [0,7] of int) ;
  var c: subrange [0, 7] of int ;
let
  n = 0 -> pre c ; 

  if start then
    c = 0 ;
  elsif inc then
    if n = 7 then
      c = 0 ;
    else
      c = n + 1 ;
    fi
  else
    c = n ;
  fi
tel
(* Note:
   Clicking the "Check Properties"  will cause Kind 2 to verify that 
   the runtime values of c and of n are indeed in the declared range.
*)

(*
  This is a utility function that converts a Boolean value 
  to an integer value of type subrange [0,1] of int. 
*)
function ToBit(b: bool) returns (n: subrange [0, 1] of int) ;
let
   n = if b then 1 else 0 ;
tel

(*
  This is a utility function that converts a 3-bit binary number
  represented by three Boolean values b2, b1, b0 to an integer value
  of type subrange [0, 7] of int. The bits are interpreted as a binary
  number, with b2 as the most significant bit and b0 as the least 
  significant bit.
*)
function ToInt(b2, b1, b0: bool) returns (n: subrange [0, 7] of int) ;
let
   n = 4 * ToBit(b2) + 2 * ToBit(b1) + ToBit(b0) ;
tel


(*
  This is an observer node that checks that the ThreeBitCounter
  behaves like a delayed resettable counter modulo 8.
  It compares the output of the ThreeBitCounter with the output
  of the DelayedCounter and checks that they are equal at all times.   
*)
node Observer(inc, start: bool) returns (n1, n2: int) ;
  var out0, out1, out2: bool ;
let
  (out0, out1, out2) = ThreeBitCounter(inc, start) ;

  n1 = ToInt(out2, out1, out0) ;

  n2 = DelayedCounter(inc, start) ;

  -- the two counters are always equal [invalid]
  check "Same count" n1 = n2 ;
  -- the two counters are equal since the last reset, 
  -- if any [still invalid!]
  check "Same count 1" Since(start, n1 = n2) ;
  -- the two counters are equal since the last reset, 
  -- provided there was one
  check "Same count 2" Once(start) => Since(start, n1 = n2) ;
  -- Safer reformulation of the previous property
  -- which additionally checks that Once(start) is not always false
  check "Same count 3" Since(start, n1 = n2) provided Once(start) ;
tel

----------------------
-- Temporal Operators
----------------------

(*
  Once(X) is true precisely when X has been true at some point 
  in the past or is true now.
  Note Once is a monotonic operator: if X is true at any point 
  in the past, Once(X) will remain true for all future steps, 
  regardless of the value of X in the future.
*)
node Once(X: bool) returns (Z: bool) ;
let
  Z =  X -> X or pre Z ;
tel

(*
  Since(X,Y) is true precisely when X has been true at some point, 
  and Y has been continuously true afterwards.
*)
node Since(X, Y: bool) returns (Z: bool) ;
let
  Z =  X or (Y and (false -> pre Z)) ;
tel




type color = enum { red, green } ;
type train_mode = enum { away, wait, bridge } ;
type train_loc = enum { arrive, leave, null } ;


node train (signal: color) 
returns (mode: train_mode; out: train_loc) ;
  var choice: int;
let
  choice = any@<int>;

  out = null -> if choice = 1 and pre mode = away   then arrive
             else if choice = 2 and pre mode = bridge then leave
             else null ;

  mode = away -> if (pre mode = away and out = arrive) or
                    (pre mode = wait and signal <> green) then wait
            else if (pre mode = wait and signal = green) or
                    (pre mode = bridge and out <> leave) then bridge
            else away ;
tel ;


node controller_1 (out_E, out_W: train_loc) 
returns (signal_E, signal_W: color) ;
  var west, east: color ;
let
  signal_W = green -> pre west ;
  signal_E = green -> pre east ;

  west = green -> if out_E = leave then green
             else if out_E = arrive then red
             else pre west ;

  east = green -> if out_W = leave then green
            else if out_E <> arrive and 
                    out_W = arrive then red
            else pre east ;
tel ;


node controller_2 (out_E, out_W: train_loc) 
returns (signal_E, signal_W: color) ;
  var near_E, near_W: bool ;
      west, east: color ;
let
  signal_E = red -> pre east ;
  signal_W = red -> pre west ;

  near_E = false -> out_E = arrive or (out_E <> leave and pre near_E) ; 
  near_W = false -> out_W = arrive or (out_E <> leave and pre near_W) ;

  east = red -> if not near_E then red
           else if pre west = red then green
           else pre east ;
  west = red -> if not near_W then red
           else if east = red then green
           else pre west ;
tel ;

type unit = enum { unit } ;

node train_system (c: subrange [1,2] of int) 
returns (out_E, out_W: train_loc; signal_E, signal_W: color) ;
  var mode_E, mode_W: train_mode ;
let
  (mode_E, out_E) = train(signal_E) ;
  (mode_W, out_W) = train(signal_W) ;

  if c = 1 then 
    (signal_E, signal_W) = controller_1(out_E, out_W) ;
  else
    (signal_E, signal_W) = controller_2(out_E, out_W) ;
  fi

  -- This safety property is satisfied with controller 2 
  -- but not with controller 1
  check "No crashes"  not (mode_E = bridge and mode_W = bridge) ;
tel ;


node west_fair_monitor (out_E, out_W: train_loc; signal_W: color)
returns (ok: bool) ;
  var mode: int ;
let
  mode = 0 -> if pre mode = 0 then
                (if out_W = arrive then 1 
                 else 0)
         else if pre mode = 1 then
                (if signal_W = green then 0 
                 else if out_E = leave then 2 
                 else 1)
         else if pre mode = 2 then
                (if signal_W = green then 0
                 else if out_E = leave then 3
                 else 2) 
         else 3 ;
                
  ok = mode <> 3 ;
tel


node top (u: unit) returns (c: subrange [1,2] of int) ;
  var out_E, out_W: train_loc; 
      signal_E, signal_W: color;
let
  c = 2;

  (out_E, out_W, signal_E, signal_W) = train_system (c) ; 

  -- This fairness property is satisfied with controller 1 
  -- but not with controller 2 
  check "Fairness for West train" 
    west_fair_monitor(out_E, out_W, signal_W) ;
tel

