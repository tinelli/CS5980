-- Figure 2.1
----------------------
(* IntDelay: a one-step delay node for integers.  
   The output is the previous input, with an initial value of 0.
*)
node IntDelay(inp: int) returns (out: int) ;
  var x: int ;
let
  out = x ;
  x = 0 -> pre inp ;
tel

(* Delay: a generic delay node for any type T.  
   The output is the previous input, with an arbitrary initial value 
   of type T.
*)
node Delay<T>(inp: T) returns (out: T) ;
  var x0, x: T ;
let
  x0 = any@<T>;
  out = x ;
  x = x0 -> pre inp ;
tel


node DiffSquare(in1, in2: int) returns (out: int) ;
let
  out = in1 * in1 - in2 * in2 ;
tel

node DiffSquare1(i1, i2: int) returns (out: int) ;
  var x, y: int ;
let
  x = i1 + i2 ;
  y = i1 - i2 ;
  out = x * y;

  -- nodeDiffSquare1 is equivalent to nodeDiffSquare 
  -- but it uses fewer multiplications.
  check out = DiffSquare(i1, i2) ;
tel


(*
        +----------------------+
        | bool x := 0 ; y := 0 |
        +----------------------+
        | bool in              |
        | if y then            |  
bool in |   out := x           | bool out
  ----->| else                 |------>
        |   out := 0 ;         |
        | x := in ;            |
        | y := ¬y              |
        +----------------------+
*)
node Mistery(inp: bool) returns (out: bool) ;
  var x, y: bool ;
let
  x = false -> inp ;
  y = false -> not pre y ;
  out = if y then x else false;
tel

(*
  Alternative implementation of the Mistery node using an 
  if ... then ... else ... fi statement instead of a conditional expression.
*)
node Mistery1(inp: bool) returns (out: bool) ;
  var x, y: bool ;
let
  x = false -> inp ;
  y = false -> not pre y ;
  if y then 
    out = x ;
  else 
    out = false ;
  fi
  -- the if statement above is equivalent to the conditional expression 
  -- in node Mistery
tel

